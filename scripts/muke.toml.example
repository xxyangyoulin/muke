# MUKE（Rust 版）配置示例。结构字段见 src/config.rs；其余键进入 [settings]（与后台站点设置同库合并，TOML 优先于默认值）。

listen = "127.0.0.1:8785"
data_dir = "/opt/muke/data"
frontend = "/opt/muke/frontend"
export_dir = "/opt/muke/dist"
timezone = "Asia/Shanghai"
setup_hosts = ["127.0.0.1", "::1"]
# HTTPS 反向代理后端建议开启
# cookie_secure = true
# 外部请求代理（部署、giscus、订阅抓取）
# http_proxy = "http://127.0.0.1:7890"

[settings]
# site_url = "https://example.com"
